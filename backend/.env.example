# ============================================================
# Backend Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# Never commit the real .env file to Git.

# MongoDB connection string
# Free cloud option: https://www.mongodb.com/atlas
# Local option:      mongodb://127.0.0.1:27017/tinyurl
MONGODB_URI=

# Port the backend listens on (default 5050)
PORT=5050

# Base URL used when building the short link that is returned to the frontend
# In development leave it as localhost. In production put your real domain.
BASE_URL=http://localhost:5050
