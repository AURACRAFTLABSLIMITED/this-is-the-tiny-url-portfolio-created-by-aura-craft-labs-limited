# ============================================================
# Backend Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# Never commit the real .env file to Git.

# MongoDB connection string
MONGODB_URI=

# Port the backend listens on (default 5050)
PORT=5050

# Base URL used when building the short link returned to the frontend.
# IMPORTANT for production (Vercel):
#   Set this to your live site domain, for example:
#   BASE_URL=https://this-is-the-tiny-url-portfolio-crea.vercel.app
# If you leave it empty, the backend will use the request host automatically.
BASE_URL=

# Optional: frontend origin (only needed if frontend is on a different domain)
CLIENT_URL=
